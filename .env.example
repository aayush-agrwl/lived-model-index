# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon pooled Postgres connection string
DATABASE_URL=postgresql://neondb_owner:XXXX@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM provider API keys (all free tier).
#
# A missing key is not fatal on its own: every slot in lib/models.ts that
# uses an unconfigured provider must carry `enabled: false`, and disabled
# slots create no runs. chatCall throws a message naming the exact variable
# if an enabled slot's key is absent.
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=

# Optional — plumbing exists, slots ship disabled (panel v5, 2026-08-17).
# Added to recover lineages the panel lost when vendors retired models.
# After setting one of these, verify BEFORE enabling its slot:
#   npx tsx scripts/probe-provider.ts cerebras
#   npx tsx scripts/probe-provider.ts huggingface
# cloud.cerebras.ai — PROBED 2026-08-17 AND NOT VIABLE on a free account:
# the key authenticates and lists a catalog, but that catalog holds only
# gemma-4-31b and gpt-oss-120b (no Llama, no Qwen), and both return 402
# payment-required on every inference call. Slot 100 stays disabled.
CEREBRAS_API_KEY=
# huggingface.co/settings/tokens — one key routes to Qwen, DeepSeek, GLM,
# Llama, Kimi, MiniMax, Phi, Aya. Metered monthly credits, not unmetered.
HUGGINGFACE_API_KEY=

# Random 64-char hex strings — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-random-hex
ADMIN_PASSWORD=replace-with-random-hex
